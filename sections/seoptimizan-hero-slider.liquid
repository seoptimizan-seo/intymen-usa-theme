{% comment %}
  Section: Seoptimizan - Hero Slider PRO
  Mantiene clases originales:
  seopt-hero, seopt-hero__media, seopt-hero__img, seopt-hero__overlay,
  seopt-hero__content, seopt-hero__content-inner, seopt-hero__heading,
  seopt-hero__text, seopt-hero__video, seopt-hero__iframe
{% endcomment %}

<section
  id="Banner-{{ section.id }}"
  class="seopt-hero seopt-hero--slider"
  data-autoplay="{{ section.settings.enable_autoplay }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
>
  <div class="seopt-hero__slider-viewport">

    {%- for block in section.blocks -%}
      {%- liquid
        assign mode = block.settings.background_mode
        assign desktop_image = block.settings.image_desktop
        assign mobile_image = block.settings.image_mobile
        assign video_file = block.settings.video_file
        assign video_url = block.settings.video_url

        assign overlay_alpha_start = block.settings.overlay_opacity_start | times: 0.01
        assign overlay_alpha_end = block.settings.overlay_opacity_end | times: 0.01
        assign overlay_c1 = block.settings.overlay_color_1 | color_modify: 'alpha', overlay_alpha_start
        assign overlay_c2 = block.settings.overlay_color_2 | color_modify: 'alpha', overlay_alpha_end
      -%}

      <div
        class="seopt-hero__slide{% if forloop.first %} is-active{% endif %}"
        data-slide-index="{{ forloop.index0 }}"
        {{ block.shopify_attributes }}
        style="
          --seopt-overlay-angle: {{ block.settings.overlay_angle }}deg;
          --seopt-overlay-c1: {{ overlay_c1 }};
          --seopt-overlay-c2: {{ overlay_c2 }};
          --seopt-overlay-stop-start: {{ block.settings.overlay_stop_start }}%;
          --seopt-overlay-stop-end: {{ block.settings.overlay_stop_end }}%;
          --seopt-content-align: {{ block.settings.content_alignment }};
          --seopt-content-vertical: {{ block.settings.content_vertical_alignment }};
          --seopt-content-max: {{ block.settings.content_max_width }}px;
          --seopt-text-align: {{ block.settings.text_alignment }};
        "
      >
        <div class="seopt-hero__media">

          {%- if mode == 'video' and video_file != blank -%}
            <div class="seopt-hero__video seopt-hero__video--shopify" aria-hidden="true">
              {{
                video_file
                | video_tag:
                  autoplay: true,
                  loop: true,
                  muted: true,
                  controls: false,
                  playsinline: true,
                  preload: 'metadata',
                  class: 'seopt-hero__video-el'
              }}
            </div>

          {%- elsif mode == 'video_url' and video_url != blank -%}
            <div class="seopt-hero__video seopt-hero__video--embed" aria-hidden="true">
              {%- if video_url.type == 'youtube' -%}
                <iframe
                  class="seopt-hero__iframe"
                  src="https://www.youtube.com/embed/{{ video_url.id }}?autoplay=1&mute=1&controls=0&loop=1&playlist={{ video_url.id }}&playsinline=1&modestbranding=1&rel=0"
                  title="Background video"
                  frameborder="0"
                  allow="autoplay; encrypted-media; picture-in-picture"
                  allowfullscreen
                  loading="lazy"></iframe>
              {%- elsif video_url.type == 'vimeo' -%}
                <iframe
                  class="seopt-hero__iframe"
                  src="https://player.vimeo.com/video/{{ video_url.id }}?autoplay=1&muted=1&background=1&loop=1&playsinline=1"
                  title="Background video"
                  frameborder="0"
                  allow="autoplay; encrypted-media; picture-in-picture"
                  allowfullscreen
                  loading="lazy"></iframe>
              {%- endif -%}
            </div>

          {%- else -%}
            {%- if mobile_image != blank -%}
              {{
                mobile_image
                | image_url: width: 2000
                | image_tag:
                  loading: 'lazy',
                  class: 'seopt-hero__img seopt-hero__img--mobile',
                  widths: '375, 550, 750, 990, 1200, 1500, 2000',
                  sizes: '(max-width: 749px) 100vw, 0px'
              }}
            {%- endif -%}

            {%- if desktop_image != blank -%}
              {{
                desktop_image
                | image_url: width: 3000
                | image_tag:
                  loading: 'lazy',
                  class: 'seopt-hero__img seopt-hero__img--desktop',
                  widths: '750, 990, 1200, 1500, 2000, 2400, 3000',
                  sizes: '(min-width: 750px) 100vw, 0px'
              }}
            {%- endif -%}

            {%- if mobile_image == blank and desktop_image == blank -%}
              <div class="seopt-hero__placeholder">
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- endif -%}
          {%- endif -%}

          <div class="seopt-hero__overlay" aria-hidden="true"></div>

          {%- if block.settings.heading != blank or block.settings.text != blank or block.settings.button_label != blank -%}
            <div class="seopt-hero__content page-width">
              <div class="seopt-hero__content-inner">
                {%- if block.settings.heading != blank -%}
                  <h2 class="seopt-hero__heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}

                {%- if block.settings.text != blank -%}
                  <div class="seopt-hero__text rte">{{ block.settings.text }}</div>
                {%- endif -%}

                {%- if block.settings.button_label != blank -%}
                  {%- if block.settings.button_link != blank -%}
                    <a class="button" href="{{ block.settings.button_link }}">
                      {{ block.settings.button_label | escape }}
                    </a>
                  {%- else -%}
                    <span class="button disabled" aria-disabled="true">
                      {{ block.settings.button_label | escape }}
                    </span>
                  {%- endif -%}
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}

        </div>
      </div>
    {%- endfor -%}

  </div>

  {%- if section.blocks.size > 1 and section.settings.show_arrows -%}
    <button class="seopt-hero__arrow seopt-hero__arrow--prev" type="button" aria-label="Slide anterior">‹</button>
    <button class="seopt-hero__arrow seopt-hero__arrow--next" type="button" aria-label="Slide siguiente">›</button>
  {%- endif -%}

  {%- if section.blocks.size > 1 and section.settings.show_dots -%}
    <div class="seopt-hero__dots">
      {%- for block in section.blocks -%}
        <button class="seopt-hero__dot{% if forloop.first %} is-active{% endif %}" type="button" data-dot-index="{{ forloop.index0 }}" aria-label="Ir al slide {{ forloop.index }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if section.settings.custom_css != blank -%}
    <style>
      #Banner-{{ section.id }} {
        {{ section.settings.custom_css }}
      }
    </style>
  {%- endif -%}

  <style>
    #Banner-{{ section.id }}{
      --seopt-min-height-mobile: {{ section.settings.min_height_mobile }}px;
      --seopt-min-height-desktop: {{ section.settings.min_height_desktop }}px;
      --seopt-border-radius: {{ section.settings.border_radius }}px;
      position: relative;
      overflow: hidden;
      border-radius: var(--seopt-border-radius);
    }

    #Banner-{{ section.id }} div:empty { display: block; }

    #Banner-{{ section.id }} .seopt-hero__slider-viewport{
      position: relative;
      min-height: var(--seopt-min-height-mobile);
      overflow: hidden;
    }

    #Banner-{{ section.id }} .seopt-hero__slide{
      position: absolute;
      inset: 0;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity .7s ease, visibility .7s ease;
      z-index: 0;
    }

    #Banner-{{ section.id }} .seopt-hero__slide.is-active{
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      z-index: 1;
    }

    #Banner-{{ section.id }} .seopt-hero__media{
      position: relative;
      min-height: var(--seopt-min-height-mobile);
      overflow: hidden;
      border-radius: var(--seopt-border-radius);
    }

    #Banner-{{ section.id }} .seopt-hero__img,
    #Banner-{{ section.id }} .seopt-hero__placeholder{
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
      object-position: right center;
      position: absolute;
      inset: 0;
      z-index: 0;
    }

    #Banner-{{ section.id }} .seopt-hero__img--desktop{ display: none; }
    #Banner-{{ section.id }} .seopt-hero__img--mobile{ display: block; }

    #Banner-{{ section.id }} .seopt-hero__video{
      position: absolute;
      inset: 0;
      z-index: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
    }

    #Banner-{{ section.id }} .seopt-hero__video-el,
    #Banner-{{ section.id }} .seopt-hero__iframe{
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
    }

    #Banner-{{ section.id }} .seopt-hero__iframe{
      position: absolute;
      inset: 0;
      transform: scale(1.15);
    }

    #Banner-{{ section.id }} .seopt-hero__overlay{
      position: absolute;
      inset: 0;
      z-index: 1;
      background: linear-gradient(
        var(--seopt-overlay-angle),
        var(--seopt-overlay-c1) var(--seopt-overlay-stop-start),
        var(--seopt-overlay-c2) var(--seopt-overlay-stop-end)
      );
      pointer-events: none;
    }

    #Banner-{{ section.id }} .seopt-hero__content{
      position: absolute;
      inset: 0;
      z-index: 2;
      display: flex;
      align-items: var(--seopt-content-vertical);
      justify-content: var(--seopt-content-align);
      padding: 2rem 0;
    }

    #Banner-{{ section.id }} .seopt-hero__content-inner{
      max-width: var(--seopt-content-max);
      width: 100%;
      padding: 2.4rem;
      text-align: var(--seopt-text-align);
    }

    #Banner-{{ section.id }} .seopt-hero__heading{
      margin: 0 0 .8rem 0;
      color: {{ section.settings.heading_color }};
      font-size: {{ section.settings.heading_size_mobile }}px;
      line-height: .95;
      font-weight: 900;
    }

    #Banner-{{ section.id }} .seopt-hero__text{
      margin-bottom: 1.2rem;
      color: {{ section.settings.text_color }};
    }

    #Banner-{{ section.id }} .seopt-hero__text *{ color: inherit; }

    #Banner-{{ section.id }} .button.disabled{
      opacity: .6;
      pointer-events: none;
    }

    #Banner-{{ section.id }} .seopt-hero__arrow{
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 5;
      width: 44px;
      height: 44px;
      border-radius: 999px;
      border: 0;
      background: rgba(0,0,0,.35);
      color: #fff;
      font-size: 34px;
      line-height: 1;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    #Banner-{{ section.id }} .seopt-hero__arrow--prev{ left: 16px; }
    #Banner-{{ section.id }} .seopt-hero__arrow--next{ right: 16px; }

    #Banner-{{ section.id }} .seopt-hero__dots{
      position: absolute;
      left: 50%;
      bottom: 18px;
      transform: translateX(-50%);
      z-index: 5;
      display: flex;
      gap: 8px;
      align-items: center;
      justify-content: center;
    }

    #Banner-{{ section.id }} .seopt-hero__dot{
      width: 9px;
      height: 9px;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,.9);
      background: transparent;
      padding: 0;
      cursor: pointer;
    }

    #Banner-{{ section.id }} .seopt-hero__dot.is-active{ background: #fff; }

    @media screen and (min-width: 750px){
      #Banner-{{ section.id }} .seopt-hero__slider-viewport,
      #Banner-{{ section.id }} .seopt-hero__media{
        min-height: var(--seopt-min-height-desktop);
      }

      #Banner-{{ section.id }} .seopt-hero__img--desktop{ display: block; }
      #Banner-{{ section.id }} .seopt-hero__img--mobile{ display: none; }

      #Banner-{{ section.id }} .seopt-hero__heading{
        font-size: {{ section.settings.heading_size_desktop }}px;
      }
    }

    @media screen and (min-width: 990px){
      #Banner-{{ section.id }} .seopt-hero__content-inner{ padding: 3.2rem; }
    }

    @media screen and (min-width: 1200px){
      #Banner-{{ section.id }} .seopt-hero__content-inner{ padding: 4rem; }
    }
  </style>

  <script>
    (() => {
      const root = document.getElementById('Banner-{{ section.id }}');
      if (!root) return;

      const slides = Array.from(root.querySelectorAll('.seopt-hero__slide'));
      const dots = Array.from(root.querySelectorAll('.seopt-hero__dot'));
      const prev = root.querySelector('.seopt-hero__arrow--prev');
      const next = root.querySelector('.seopt-hero__arrow--next');

      if (slides.length <= 1) return;

      let current = 0;
      let timer = null;
      const autoplay = root.dataset.autoplay === 'true';
      const speed = Number(root.dataset.autoplaySpeed || 5000);

      function goTo(index) {
        slides[current].classList.remove('is-active');
        if (dots[current]) dots[current].classList.remove('is-active');

        current = (index + slides.length) % slides.length;

        slides[current].classList.add('is-active');
        if (dots[current]) dots[current].classList.add('is-active');
      }

      function startAutoplay() {
        if (!autoplay) return;
        stopAutoplay();
        timer = setInterval(() => goTo(current + 1), speed);
      }

      function stopAutoplay() {
        if (timer) clearInterval(timer);
      }

      if (prev) prev.addEventListener('click', () => { goTo(current - 1); startAutoplay(); });
      if (next) next.addEventListener('click', () => { goTo(current + 1); startAutoplay(); });

      dots.forEach(dot => {
        dot.addEventListener('click', () => {
          goTo(Number(dot.dataset.dotIndex));
          startAutoplay();
        });
      });

      root.addEventListener('mouseenter', stopAutoplay);
      root.addEventListener('mouseleave', startAutoplay);

      startAutoplay();
    })();
  </script>
</section>

{% schema %}
{
  "name": "Seopt - Hero Slider PRO",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Slider" },
    { "type": "checkbox", "id": "enable_autoplay", "label": "Activar autoplay", "default": true },
    { "type": "range", "id": "autoplay_speed", "label": "Tiempo entre slides (segundos)", "min": 3, "max": 12, "step": 1, "default": 5 },
    { "type": "checkbox", "id": "show_arrows", "label": "Mostrar flechas", "default": true },
    { "type": "checkbox", "id": "show_dots", "label": "Mostrar puntos", "default": true },

    { "type": "header", "content": "Altura general" },
    { "type": "range", "id": "min_height_mobile", "label": "Altura mínima mobile (px)", "min": 220, "max": 900, "step": 10, "default": 520 },
    { "type": "range", "id": "min_height_desktop", "label": "Altura mínima desktop (px)", "min": 280, "max": 1200, "step": 10, "default": 620 },
    { "type": "range", "id": "border_radius", "label": "Borde redondeado (px)", "min": 0, "max": 40, "step": 2, "default": 0 },

    { "type": "header", "content": "Estilo global del texto" },
    { "type": "color", "id": "heading_color", "label": "Color título", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Color texto", "default": "#ffffff" },
    { "type": "range", "id": "heading_size_mobile", "label": "Tamaño título mobile (px)", "min": 24, "max": 90, "step": 2, "default": 48 },
    { "type": "range", "id": "heading_size_desktop", "label": "Tamaño título desktop (px)", "min": 40, "max": 140, "step": 2, "default": 80 },

    { "type": "header", "content": "CSS exclusivo" },
    { "type": "textarea", "id": "custom_css", "label": "CSS personalizado", "info": "Se inserta dentro de #Banner-SECTION_ID { ... }" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "limit": 5,
      "settings": [
        {
          "type": "select",
          "id": "background_mode",
          "label": "Tipo de background",
          "default": "image",
          "options": [
            { "value": "image", "label": "Imagen desktop/mobile" },
            { "value": "video", "label": "Video MP4 Shopify" },
            { "value": "video_url", "label": "Video YouTube/Vimeo" }
          ]
        },
        { "type": "image_picker", "id": "image_desktop", "label": "Imagen Desktop" },
        { "type": "image_picker", "id": "image_mobile", "label": "Imagen Mobile" },
        { "type": "video", "id": "video_file", "label": "Video MP4 Shopify" },
        { "type": "video_url", "id": "video_url", "accept": ["youtube", "vimeo"], "label": "URL YouTube/Vimeo" },

        { "type": "header", "content": "Contenido" },
        { "type": "text", "id": "heading", "label": "Título", "default": "3PACKS" },
        { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Seguridad y presencia que se siente</p>" },
        { "type": "text", "id": "button_label", "label": "Etiqueta de botón", "default": "HAZ TUYO EL 3-PACK" },
        { "type": "url", "id": "button_link", "label": "Link del botón" },

        { "type": "header", "content": "Overlay del slide" },
        { "type": "color", "id": "overlay_color_1", "label": "Color 1", "default": "#000000" },
        { "type": "range", "id": "overlay_opacity_start", "label": "Opacidad Color 1 (%)", "min": 0, "max": 100, "step": 5, "default": 70 },
        { "type": "range", "id": "overlay_stop_start", "label": "Posición Color 1 (%)", "min": 0, "max": 100, "step": 5, "default": 0 },
        { "type": "color", "id": "overlay_color_2", "label": "Color 2", "default": "#000000" },
        { "type": "range", "id": "overlay_opacity_end", "label": "Opacidad Color 2 (%)", "min": 0, "max": 100, "step": 5, "default": 30 },
        { "type": "range", "id": "overlay_stop_end", "label": "Posición Color 2 (%)", "min": 0, "max": 100, "step": 5, "default": 100 },
        { "type": "range", "id": "overlay_angle", "label": "Ángulo del gradiente", "min": 0, "max": 360, "step": 5, "default": 180 },

        { "type": "header", "content": "Posición del contenido" },
        { "type": "range", "id": "content_max_width", "label": "Ancho máximo contenido (px)", "min": 320, "max": 900, "step": 10, "default": 720 },
        {
          "type": "select",
          "id": "content_alignment",
          "label": "Alineación horizontal",
          "default": "center",
          "options": [
            { "value": "flex-start", "label": "Izquierda" },
            { "value": "center", "label": "Centro" },
            { "value": "flex-end", "label": "Derecha" }
          ]
        },
        {
          "type": "select",
          "id": "content_vertical_alignment",
          "label": "Alineación vertical",
          "default": "center",
          "options": [
            { "value": "flex-start", "label": "Arriba" },
            { "value": "center", "label": "Centro" },
            { "value": "flex-end", "label": "Abajo" }
          ]
        },
        {
          "type": "select",
          "id": "text_alignment",
          "label": "Alineación del texto",
          "default": "center",
          "options": [
            { "value": "left", "label": "Izquierda" },
            { "value": "center", "label": "Centro" },
            { "value": "right", "label": "Derecha" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Seoptimizan - Hero Slider PRO",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}